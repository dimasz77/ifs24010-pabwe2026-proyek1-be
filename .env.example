# Salin file ini menjadi .env lalu sesuaikan nilainya
NODE_ENV=development
PORT=4000
# Lokasi file database SQLite (folder akan dibuat otomatis)
DB_PATH=./data/rental.db
# Origin frontend yang diizinkan (pisahkan dengan koma). Isi dengan URL frontend yang di-deploy.
CORS_ORIGINS=http://localhost:5173
# Isi data contoh otomatis bila tabel masih kosong (true/false). Default false = database kosong
AUTO_SEED=false
# Pengali denda keterlambatan terhadap tarif harian per hari terlambat
LATE_FEE_MULTIPLIER=1.5

# Kunci penandatangan token login. WAJIB diganti di produksi (min. 32 karakter acak)
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
# Masa berlaku token (jam)
TOKEN_TTL_HOURS=168
# true = siapa pun bisa mendaftar; ubah ke false setelah akun pemilik dibuat
ALLOW_REGISTRATION=true
